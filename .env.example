# 从正式/测试环境各自的 BotFather 获取；不要提交真实密钥。
BOT_TOKEN=
TELEGRAM_ENV=test
API_ROOT=https://api.telegram.org
HOST=127.0.0.1
PORT=8532
DB_PATH=data/diobot.sqlite
# 公网通过反向代理 HTTPS 访问；正式环境必须配置真实 Turnstile key。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
VERIFY_HOSTNAME=verify.example.com
# 公开群：自由加入，不进行入群验证/发言检查。多个 ID 用逗号分隔。
PUBLIC_CHAT_IDS=
# 可在私聊使用 /stats 的账号 ID。
OWNER_IDS=
# off / observe（只记录）/ delete（删除明确广告）；默认 off。
MODERATION_MODE=off
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# 本地每天 UTC 请求次数上限，不等同于 Cloudflare 的 Neurons 额度。
AI_DAILY_LIMIT=1000
