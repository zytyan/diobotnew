# 从正式/测试环境各自的 BotFather 获取；不要提交真实密钥。
BOT_TOKEN=
TELEGRAM_ENV=test
API_ROOT=https://api.telegram.org
HOST=127.0.0.1
PORT=8532
DB_PATH=data/diobot.sqlite
# 可全部省略以关闭验证；开启验证需三项完整配置。公网通过反向代理 HTTPS 访问。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
VERIFY_HOSTNAME=
# 仅初始化新群默认设置：这些群默认关闭入群验证。已有群通过 /settings 配置。
PUBLIC_CHAT_IDS=
# 可在私聊使用 /stats 的账号 ID。
OWNER_IDS=
# off / observe（只记录）/ delete（删除明确广告）；默认 off。
MODERATION_MODE=off
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# 本地每天 UTC 请求次数上限，不等同于 Cloudflare 的 Neurons 额度。
AI_DAILY_LIMIT=1000
